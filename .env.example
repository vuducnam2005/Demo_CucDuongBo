# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR KCHT ROAD INFRASTRUCTURE PLATFORM
# ==============================================================================

# Database Settings (PostgreSQL 16 + PostGIS 3.4+)
POSTGRES_DB=kcht_db
POSTGRES_USER=kcht_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_PORT=5436

# System Timezone (Mandatory UTC)
TZ=UTC
PGTZ=UTC

# Flyway Settings
FLYWAY_CONNECT_RETRIES=60

# MinIO / S3 Object Storage Settings
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
MINIO_ROOT_USER=kcht_minio_user
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_BUCKET=kcht-documents
MINIO_ENDPOINT=http://localhost:9010

# Backend Service Settings
SERVER_PORT=8089
KCHT_DATA_DIR=C:\Data\kcht_json_2026-10-05

# JWT Authentication Settings (Harmless placeholders)
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_chars_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Refresh Cookie Settings
REFRESH_COOKIE_NAME=CHANGE_ME_REFRESH_COOKIE_NAME
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=CHANGE_ME_LAX_OR_STRICT
REFRESH_COOKIE_DOMAIN=CHANGE_ME_LOCAL_COOKIE_DOMAIN_OR_EMPTY
REFRESH_COOKIE_PATH=CHANGE_ME_COOKIE_PATH

# Frontend Service Settings
VITE_PORT=3000
VITE_API_BASE_URL=http://localhost:8089

# Local demo login only; use rotate_local_demo_passwords.ps1 after creating the database.
# Never copy a shared demo password to public or production deployment.
DEMO_ADMIN_PASSWORD=replace_with_local_only_password
DEMO_EDITOR_PASSWORD=replace_with_local_only_password
DEMO_MANAGER_PASSWORD=replace_with_local_only_password
DEMO_VIEWER_PASSWORD=replace_with_local_only_password
