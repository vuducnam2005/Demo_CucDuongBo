# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# HỆ THỐNG QUẢN LÝ DỮ LIỆU HẠ TẦNG GIAO THÔNG ĐƯỜNG BỘ (KCHT ĐB)
# ==============================================================================
# LƯU Ý BẢO MẬT QUAN TRỌNG:
# 1. SAO CHÉP TỆP NÀY THÀNH .env.production TRÊN MÁY CHỦ SẢN XUẤT.
# 2. THAY ĐỔI TOÀN BỘ CÁC GIÁ TRỊ PLACEHOLDER BẰNG MẬT MÃ MẠNH (TỐI THIỂU 32 KÝ TỰ).
# 3. TUYỆT ĐỐI KHÔNG COMMIT .env.production VÀO HỆ THỐNG QUẢN LÝ MÃ NGUỒN GIT.
# 4. THIẾT LẬP QUYỀN TRUY CẬP TỆP CHỈ DÀNH CHO ROOT/DEPLOYER: chmod 600 .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cơ sở dữ liệu PostgreSQL 16 + PostGIS 3.4
# ------------------------------------------------------------------------------
POSTGRES_DB=kcht_prod_db
POSTGRES_USER=kcht_prod_admin
# Mật khẩu database sản xuất: sinh ngẫu nhiên chuỗi hex/base64 an toàn 32+ ký tự
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_POSTGRES_STRONG_PASSWORD_32CHARS
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Vùng lưu trữ Đối tượng MinIO / S3 Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=kcht_prod_s3_admin
# Mật khẩu root MinIO sản xuất: sinh ngẫu nhiên chuỗi hex/base64 an toàn 32+ ký tự
MINIO_ROOT_PASSWORD=CHANGE_ME_PRODUCTION_MINIO_STRONG_PASSWORD_32CHARS
MINIO_BUCKET=kcht-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 3. Bảo mật Xác thực JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# Khóa bí mật ký token HMAC-SHA256 (Tối thiểu 256 bits / 32 bytes ngẫu nhiên)
# Lệnh sinh khóa: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_BASE64_AT_LEAST_64_CHARS_RANDOM_KEY
# Thời hạn sống Access Token: 15 phút = 900000 ms
JWT_ACCESS_EXPIRATION_MS=900000
# Thời hạn sống Refresh Token (HttpOnly Cookie): 7 ngày = 604800000 ms
JWT_REFRESH_EXPIRATION_MS=604800000

# Refresh Cookie Settings (production HTTPS)
REFRESH_COOKIE_NAME=CHANGE_ME_PRODUCTION_REFRESH_COOKIE_NAME
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Strict
REFRESH_COOKIE_DOMAIN=CHANGE_ME_PRODUCTION_COOKIE_DOMAIN
REFRESH_COOKIE_PATH=/api/auth

# ------------------------------------------------------------------------------
# 4. Cấu hình Reverse Proxy & Mạng ngoài
# ------------------------------------------------------------------------------
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
DOMAIN_NAME=CHANGE_ME_PRODUCTION_DOMAIN

# ------------------------------------------------------------------------------
# 5. Cấu hình Bộ kết nối HikariCP và Backend Resource Pool
# ------------------------------------------------------------------------------
HIKARI_MAX_POOL_SIZE=25
HIKARI_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 6. Cấu hình Sao lưu & Khôi phục (Backup & Disaster Recovery)
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/kcht
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=CHANGE_ME_GPG_BACKUP_ENCRYPTION_PASSPHRASE
REMOTE_S3_BACKUP_BUCKET=kcht-offsite-backups
